{
  "name": "multi-jest-github-action",
  "version": "1.1.0",
  "description": "Jest action adding checks to your pull requests when you use multiple jest config files",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "build": "tsc",
    "pack": "ncc build lib/run.js -m -s --license licenses.txt",
    "prepack": "npm run build",
    "failing-test": "jest failing-tests",
    "test": "jest /tests/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pouish85/jest-github-action.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Jest",
    "Pull request"
  ],
  "author": "Pouish85",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pouish85/jest-github-action/issues"
  },
  "homepage": "https://github.com/pouish85/jest-github-action",
  "jest": {
    "clearMocks": true,
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "verbose": true
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^9.1.1",
    "lodash": "^4.17.21",
    "markdown-table": "^2.0.0",
    "strip-ansi": "^6.0.0"
  },
  "devDependencies": {
    "@octokit/plugin-rest-endpoint-methods": "^10.1.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.202",
    "@types/markdown-table": "^2.0.0",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  }
}
